#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

supports_fzf_tmux() {
    local tmux_version tmux_major tmux_minor

    tmux_version=$(tmux -V | sed 's/^tmux //' | sed 's/[^0-9.]//g')
    tmux_major=${tmux_version%%.*}
    tmux_minor=${tmux_version#*.}
    tmux_minor=${tmux_minor%%.*}

    [[ $tmux_major -gt 3 || ( $tmux_major -eq 3 && $tmux_minor -ge 3 ) ]]
}

discover_repos() {
    {
        while IFS= read -r git_path; do
            dirname "$git_path"
        done < <(fd '^\.git$' "$HOME" / --min-depth 2 --max-depth 3 --type f --hidden --follow 2>/dev/null)

        while IFS= read -r git_path; do
            dirname "$git_path"
        done < <(fd '^\.git$' "$HOME" / --min-depth 2 --max-depth 3 --type d --hidden --follow 2>/dev/null)
    } | awk '!/\/\./ && $0 !~ /^\/tmp(\/|$)/' | sort -u
}

main() {
    local workspaces workspace
    local -a fzf_args=(
        --cycle
        --border=bold
        --border-label ' Session Finder '
        --color 'light,bg:#fdf6e3,fg:#2e3440,bg+:#eee8d5,fg+:#2e3440,border:#ffd7af,label:#9c5f2d:bold,hl:#9c5f2d,hl+:#9c5f2d:bold,prompt:#9c5f2d,pointer:#9c5f2d,info:#657b83,footer:#657b83'
        --footer 'Enter: open · Esc: cancel'
    )

    workspaces=$(
        printf '%s\n' '~'
        discover_repos
    )

    if supports_fzf_tmux; then
        fzf_args+=(--tmux=center,70%,65%)
    fi

    workspace=$(printf '%s\n' "$workspaces" | fzf "${fzf_args[@]}" || true)
    [[ -n $workspace ]] || exit 0

    if [[ $workspace == '~' ]]; then
        workspace=$HOME
    fi

    exec "$script_dir/tmux-sessionizer" "$workspace"
}

main "$@"
